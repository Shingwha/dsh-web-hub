{
  "name": "dsh-web-hub",
  "version": "0.9.8",
  "description": "DeepSeek Harness plugin: search and fetch tools from multiple providers, switched per tool.",
  "type": "module",
  "license": "MIT",
  "author": "Shingwha",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "search",
    "fetch",
    "anysearch",
    "exa",
    "tavily",
    "firecrawl",
    "mcp"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shingwha/dsh-web-hub.git"
  },
  "homepage": "https://github.com/Shingwha/dsh-web-hub#readme",
  "bugs": {
    "url": "https://github.com/Shingwha/dsh-web-hub/issues"
  }
}
