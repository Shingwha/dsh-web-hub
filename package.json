{
  "name": "dsh-web-hub",
  "version": "0.3.2",
  "description": "DeepSeek Harness plugin: hosts provider-owned search and fetch tools behind one switches panel.",
  "type": "module",
  "license": "MIT",
  "author": "Shingwha",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "search",
    "fetch",
    "anysearch"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
